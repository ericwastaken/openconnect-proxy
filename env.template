# Make a copy of this file for EACH VPN that you want to connect to.
# Each environment should have a unique name for the file.
# Optional. Defaults to ericwastakenondocker/openconnect-proxy:latest.
#IMAGE=openconnect-proxy:saml-test
USERNAME=
PASSWORD=
HOST=
FINGERPRINT=
# Some hosts need 2 fingerprints
#FINGERPRINT_2=
AUTHGROUP=""
# One of the Protocols supported by OPENCONNECT https://www.infradead.org/openconnect/manual.html
PROTOCOL=gp|nc|pulse|f5|fortinet|array
# password or saml. SAML mode currently supports GlobalProtect (gp) only.
AUTH_MODE=password
# Required only for AUTH_MODE=saml. Expose this web/noVNC port to complete SAML login.
SAML_AUTH_PORT=8080
# portal or gateway. Start with portal unless your VPN requires gateway SAML auth.
SAML_MODE=portal
# Some GlobalProtect SAML portals only expose SAML when the client OS is Windows.
SAML_CLIENTOS=Windows
# Ignore portal TLS chain verification in gp-saml-gui. OpenConnect still uses FINGERPRINT pins.
SAML_NO_VERIFY=true
# For local SAML mock testing only. Stops after gp-saml-gui returns auth values.
SAML_AUTH_ONLY=false
# Recommended 8222, 8223, 8224, 8225, 8226, 8227, 8228, 8229
# Be sure you expose this in your docker CLI or docker-compose.yml
PROXY_PORT=8222
